# TAO-DASH — Configuration
# Copie ce fichier en .env et renseigne tes valeurs.
# cp .env.example .env

# Clé API Taostats (obligatoire pour les données live)
# Obtenir une clé gratuite sur : https://taostats.io/pro
TAOSTATS_API_KEY=

# URL Redis pour le cache metagraph (optionnel — dégradation gracieuse si absent)
# Format : redis://localhost:6379  ou  redis://:password@host:port
REDIS_URL=redis://localhost:6379

# URL WebSocket du nœud Substrate Finney (optionnel — défaut : wss://entrypoint-finney.opentensor.ai)
# SUBSTRATE_WS_URL=wss://entrypoint-finney.opentensor.ai
